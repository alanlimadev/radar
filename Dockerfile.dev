FROM node:22-alpine

WORKDIR /app

# Instala dependências primeiro (aproveita cache de layer)
COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

# Copia o restante do código-fonte
COPY . .

# Gera o Prisma Client (SQLite)
RUN npx prisma generate

EXPOSE 3333

# Em produção (build do executável) usa o Dockerfile padrão.
# Aqui o comando é sobrescrito pelo docker-compose (dev com hot-reload).
CMD ["npm", "run", "start:dev"]
