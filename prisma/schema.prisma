generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// RADAR Core Framework Models (Generic & Decoupled)
// ----------------------------------------------------

model Host {
    id           String     @id @default(uuid())
    name         String
    email        String     @unique
    passwordHash String
    quizzes      Quiz[]     @relation("HostQuizzes")
    rooms        GameRoom[]

    @@map("hosts")
}

model GameRoom {
    id        String       @id @default(uuid())
    code      String       @unique
    gameType  String
    hostId    String
    host      Host         @relation(fields: [hostId], references: [id])
    status    String       @default("LOBBY") // LOBBY, IN_PROGRESS, FINISHED
    config    Json         @default("{}")
    results   Json?
    startedAt DateTime     @default(now())
    endedAt   DateTime?
    players   RoomPlayer[]

    @@map("game_rooms")
}

model RoomPlayer {
    id       String   @id @default(uuid())
    name     String
    roomId   String
    room     GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
    score    Int      @default(0)
    metadata Json?
    joinedAt DateTime @default(now())

    @@map("room_players")
}

// ----------------------------------------------------
// Module Quiz (Proof of Concept - Content Storage)
// ----------------------------------------------------

model Quiz {
    id          String     @id @default(uuid())
    title       String
    description String?
    createdBy   String
    creator     Host       @relation("HostQuizzes", fields: [createdBy], references: [id])
    questions   Question[]

    @@map("quizzes")
}

model Question {
    id           String        @id @default(uuid())
    text         String
    order        Int
    quizId       String
    quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
    alternatives Alternative[]

    @@map("questions")
}

model Alternative {
    id         String   @id @default(uuid())
    text       String
    isCorrect  Boolean
    questionId String
    question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

    @@map("alternatives")
}
